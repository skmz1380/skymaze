---
const projects = [
  {
    number: "01",
    title: "Engine Control",
    description:
      "Control systems, modeling, identification and intelligent control for propulsion systems.",
    tags: ["Control", "MATLAB", "Embedded"],
  },
  {
    number: "02",
    title: "Lower Limb Exoskeleton",
    description:
      "RL-augmented NMPC for adaptive rehabilitation and human-robot interaction.",
    tags: ["RL", "NMPC", "Robotics"],
  },
  {
    number: "03",
    title: "Satellite SIL",
    description:
      "Software-in-the-loop modeling, attitude control and sun-pointing systems.",
    tags: ["Aerospace", "SIL", "Control"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="SKy MaZe — A Man Who Never Gives Up." />
    <title>SKy MaZe — A Man Who Never Gives Up</title>
  </head>

  <body>
    <header class="navbar">
      <a href="/" class="logo">SK<span>y</span> MaZe</a>

      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#research">Research</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">ENGINEER · RESEARCHER · BUILDER</p>

          <h1>
            SKy MaZe
          </h1>

          <h2>A Man Who Never Gives Up.</h2>

          <p class="intro">
            Exploring control, aerospace, embedded systems and intelligent
            machines — one problem at a time.
          </p>

          <div class="hero-buttons">
            <a href="#projects" class="button primary">
              Explore My Work
            </a>

            <a href="#about" class="button secondary">
              About Me
            </a>
          </div>
        </div>

        <div class="hero-mark">
          <div class="circle"></div>
          <span>SKMZ</span>
        </div>
      </section>

      <section id="about" class="section about">
        <div class="section-label">01 / ABOUT</div>

        <div class="section-content">
          <h2>Engineering is not just about solving problems.</h2>

          <p>
            It is about refusing to stop when the problem becomes difficult.
            My work lives at the intersection of control systems, mechanical
            engineering, aerospace and embedded systems.
          </p>

          <p>
            I enjoy understanding complex systems from the inside, building
            models, writing code, testing ideas and turning theory into
            something that actually works.
          </p>
        </div>
      </section>

      <section id="projects" class="section projects">
        <div class="section-label">02 / SELECTED WORK</div>

        <div class="project-list">
          {projects.map((project) => (
            <article class="project">
              <span class="project-number">{project.number}</span>

              <div class="project-main">
                <h3>{project.title}</h3>
                <p>{project.description}</p>

                <div class="tags">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>

              <span class="arrow">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section id="research" class="section research">
        <div class="section-label">03 / RESEARCH</div>

        <div class="research-grid">
          <div>
            <h2>Ideas become systems.</h2>
          </div>

          <div>
            <p>
              Research, technical notes, experiments and things I learned
              while trying to make complicated systems behave.
            </p>

            <a href="#" class="text-link">Explore Research →</a>
          </div>
        </div>
      </section>

      <section id="contact" class="section contact">
        <div class="section-label">04 / CONTACT</div>

        <div>
          <h2>Let's build something.</h2>
          <p>
            For engineering, research or technical collaboration.
          </p>

          <a href="mailto:hello@skymaze.ir" class="email">
            hello@skymaze.ir
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div>SKy MaZe</div>
      <div>A Man Who Never Gives Up.</div>
      <div>© 2026</div>
    </footer>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap");

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #080b0f;
    color: #e8edf2;
    font-family: "Inter", sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .navbar {
    width: min(1200px, calc(100% - 48px));
    height: 90px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #1b222b;
  }

  .logo {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .logo span {
    color: #7dd3fc;
  }

  nav {
    display: flex;
    gap: 32px;
  }

  nav a {
    color: #8c98a5;
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #fff;
  }

  .hero {
    width: min(1200px, calc(100% - 48px));
    min-height: calc(100vh - 90px);
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 80px;
    position: relative;
  }

  .hero-content {
    max-width: 760px;
    padding: 100px 0;
  }

  .eyebrow,
  .section-label {
    color: #667381;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .hero h1 {
    margin: 22px 0 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(4rem, 10vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  .hero h2 {
    margin: 32px 0 0;
    color: #cbd5df;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 600px;
    margin: 28px 0 0;
    color: #8995a3;
    font-size: 1.05rem;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    margin-top: 42px;
  }

  .button {
    padding: 13px 21px;
    border: 1px solid #29323d;
    font-size: 0.82rem;
    font-weight: 600;
    transition: 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
    border-color: #536273;
  }

  .primary {
    background: #e8edf2;
    color: #080b0f;
  }

  .secondary {
    color: #cbd5df;
  }

  .hero-mark {
    width: 220px;
    height: 220px;
    position: relative;
    display: grid;
    place-items: center;
    border: 1px solid #1d2630;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .circle {
    position: absolute;
    width: 130px;
    height: 130px;
    border: 1px solid #33404d;
    border-radius: 50%;
  }

  .hero-mark span {
    z-index: 1;
    color: #657280;
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
  }

  .section {
    width: min(1200px, calc(100% - 48px));
    margin: auto;
    padding: 130px 0;
    border-top: 1px solid #1b222b;
  }

  .section-content {
    max-width: 750px;
    margin-left: auto;
  }

  .section h2 {
    margin: 0 0 28px;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.06em;
  }

  .section p {
    color: #8c98a5;
    font-size: 1rem;
  }

  .section-content p {
    max-width: 680px;
  }

  .project-list {
    margin-top: 70px;
  }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr 40px;
    gap: 30px;
    padding: 36px 0;
    border-top: 1px solid #1b222b;
    transition: padding 0.25s ease;
  }

  .project:last-child {
    border-bottom: 1px solid #1b222b;
  }

  .project:hover {
    padding-left: 15px;
  }

  .project-number {
    color: #55616e;
    font-size: 0.8rem;
  }

  .project h3 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.7rem;
  }

  .project p {
    max-width: 650px;
    margin: 10px 0 18px;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tags span {
    padding: 5px 9px;
    border: 1px solid #222b34;
    color: #687583;
    font-size: 0.68rem;
  }

  .arrow {
    color: #596674;
    font-size: 1.3rem;
  }

  .research-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    margin-top: 60px;
  }

  .text-link {
    display: inline-block;
    margin-top: 25px;
    color: #c9d3dc;
    border-bottom: 1px solid #485563;
    padding-bottom: 4px;
  }

  .contact {
    padding-bottom: 160px;
  }

  .contact > div:last-child {
    margin-top: 60px;
  }

  .email {
    display: inline-block;
    margin-top: 20px;
    color: #dce5ed;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.5rem, 4vw, 3rem);
    letter-spacing: -0.04em;
    border-bottom: 1px solid #394550;
  }

  footer {
    width: min(1200px, calc(100% - 48px));
    margin: auto;
    padding: 30px 0;
    display: flex;
    justify-content: space-between;
    color: #4f5b67;
    font-size: 0.7rem;
    border-top: 1px solid #1b222b;
  }

  @media (max-width: 800px) {
    .navbar {
      height: 75px;
    }

    nav {
      display: none;
    }

    .hero {
      min-height: auto;
    }

    .hero-content {
      padding: 100px 0;
    }

    .hero-mark {
      display: none;
    }

    .section {
      padding: 90px 0;
    }

    .section-content {
      margin-top: 50px;
    }

    .research-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .project {
      grid-template-columns: 45px 1fr 20px;
      gap: 12px;
    }

    footer {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>