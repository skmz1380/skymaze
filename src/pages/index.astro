    .maze path {
      fill: none;
      stroke: var(--accent);
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 1600;
      stroke-dashoffset: 1600;
      animation: drawMaze 3s cubic-bezier(.65,0,.35,1) .3s forwards;
    }

    .maze .faint {
      stroke: #27334a;
      opacity: .65;
    }

    .maze circle {
      fill: var(--accent);
      opacity: 0;
      animation: node .45s ease forwards;
    }

    .maze circle:nth-of-type(1) { animation-delay: 1s; }
    .maze circle:nth-of-type(2) { animation-delay: 1.7s; }
    .maze circle:nth-of-type(3) { animation-delay: 2.3s; }
    .maze circle:nth-of-type(4) { animation-delay: 2.8s; }

    @keyframes drawMaze {
      to { stroke-dashoffset: 0; }
    }

    @keyframes node {
