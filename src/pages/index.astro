---
const projects = [
  {
    number: "01",
    type: "ROBOTICS · AI",
    title: "RL-Augmented MPC",
    subtitle: "Adaptive control for a lower-limb rehabilitation exoskeleton.",
    tags: ["DDPG", "EPFC", "Reinforcement Learning", "NMPC", "Robotics"],
    motif: "/LLER.png",
  },
  {
    number: "02",
    type: "AEROSPACE",
    title: "Kosar 1.5 ADCS",
    subtitle: "Attitude determination and control for sun-pointing and inertial-pointing missions.",
    tags: ["ADCS", "Simulink", "SIL", "Reaction Wheels", "Magnetorquers"],
    motif: "/satellite-orbit.svg",
  },
  {
    number: "03",
    type: "CONTROL · SOFTWARE",
    title: "Aircraft ECU Reverse Engineering",
    subtitle: "System-level reconstruction of control behavior and embedded numerical logic.",
    tags: ["FADEC", "Reverse Engineering", "CFM56", "Embedded Systems"],
    motif: "/turbine-spin.svg",
  },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="theme-color" content="#070a10" />
  <title>SKy MaZe — Seyed Kazem Moosavi Zargar</title>
  <meta
    name="description"
    content="Seyed Kazem Moosavi Zargar — Control Systems & Software Engineer working across intelligent control, aerospace and robotics."
  />

  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <style>
    :root {
      --bg: #070a10;
      --bg2: #0a0f18;
      --card: #0d131e;
      --line: #1a2332;
      --text: #edf2fa;
      --muted: #9ba7ba;
      --dim: #626d80;
      --accent: #4f8cff;
      --accent2: #7ca9ff;
      --glow: rgba(79, 140, 255, .18);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family:
        Inter, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1160px, calc(100% - 48px));
      margin-inline: auto;
    }

    /* ---------- NAV ---------- */

    nav {
      position: fixed;
      inset: 0 0 auto;
      z-index: 100;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 max(24px, calc((100vw - 1160px) / 2));
      background: rgba(7, 10, 16, .78);
      border-bottom: 1px solid rgba(255,255,255,.06);
      backdrop-filter: blur(16px);
    }

    .logo {
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -.04em;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 28px;
      color: var(--muted);
      font-size: 13px;
    }

    .nav-links a {
      transition: color .2s;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    /* ---------- HERO ---------- */

    #stars {
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
    }

    .hero {
      max-width: 720px;
      margin: 0 auto;
      padding: 180px 24px 110px;
      text-align: left;
    }

    .hero-name {
      font-size: clamp(44px, 7vw, 80px);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -.045em;
      color: var(--text);
      margin: 0 0 18px;
    }

    .hero-role {
      font-size: 20px;
      color: var(--muted);
      margin: 0 0 14px;
    }

    .hero-line {
      font-size: 15px;
      line-height: 1.7;
      color: var(--dim);
      max-width: 52ch;
      margin: 0 0 8px;
    }

    .hero-motto {
      display: inline-flex;
      align-items: center;
      gap: 13px;
      margin-top: 26px;
      padding: 11px 17px;
      border: 1px solid rgba(79,140,255,.25);
      border-radius: 8px;
      background: rgba(79,140,255,.07);
      font-size: 14px;
      font-style: italic;
      font-weight: 600;
      color: var(--muted);
    }

    .hero-motto::before {
      content: "—";
      color: var(--accent);
      font-style: normal;
      font-weight: 800;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 34px;
    }

    .hero-signature {
      display: block;
      width: 120px;
      opacity: .5;
      margin-top: 48px;
    }

    .button {
      display: inline-block;
      padding: 12px 20px;
      border-radius: 7px;
      border: 1px solid var(--line);
      font-size: 13.5px;
      font-weight: 650;
      transition: .2s ease;
    }

    .button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: white;
    }

    .button:hover {
      transform: translateY(-2px);
      border-color: rgba(79,140,255,.45);
      box-shadow: 0 10px 28px -16px rgba(79,140,255,.7);
    }

    /* ---------- GENERAL ---------- */

    section {
      border-bottom: 1px solid var(--line);
    }

    .section {
      padding: 110px 0;
    }

    .section-heading {
      margin-bottom: 54px;
    }

    .eyebrow {
      color: var(--accent2);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    .section-heading h2 {
      font-size: clamp(34px, 4vw, 48px);
      letter-spacing: -.04em;
      line-height: 1;
    }

    .section-heading p {
      margin-top: 15px;
      color: var(--dim);
      max-width: 600px;
      font-size: 15px;
    }

    /* ---------- ABOUT ---------- */

    .about-grid {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 70px;
    }

    .about-text {
      color: var(--muted);
      font-size: 17px;
      line-height: 1.85;
    }

    .about-text strong {
      color: var(--text);
      font-weight: 650;
    }

    .facts {
      display: grid;
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
    }

    .fact {
      background: var(--card);
      padding: 19px 21px;
    }

    .fact small {
      display: block;
      color: var(--dim);
      text-transform: uppercase;
      letter-spacing: .12em;
      font-size: 10px;
      font-weight: 700;
    }

    .fact strong {
      display: block;
      margin-top: 5px;
      font-size: 14px;
    }

    /* ---------- EXPERIENCE ---------- */

    .timeline {
      border-left: 1px solid var(--line);
      margin-left: 8px;
    }

    .timeline-item {
      position: relative;
      padding: 0 0 55px 34px;
    }

    .timeline-item:last-child {
      padding-bottom: 0;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: -5px;
      top: 5px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--accent);
      box-shadow: 0 0 18px var(--glow);
    }

    .date {
      color: var(--accent2);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .timeline h3 {
      margin-top: 7px;
      font-size: 21px;
      letter-spacing: -.02em;
    }

    .company {
      color: var(--muted);
      font-size: 14px;
      margin-top: 3px;
    }

    .timeline p {
      color: var(--dim);
      font-size: 14px;
      margin-top: 12px;
      max-width: 700px;
    }

    .org-logos {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 40px;
      margin-top: 60px;
      padding-top: 40px;
      border-top: 1px solid var(--line);
    }

    .org-logos img {
      height: 26px;
      width: auto;
      filter: grayscale(1) brightness(1.7);
      opacity: .55;
      transition: opacity .2s ease;
    }

    .org-logos img:hover {
      opacity: 1;
    }

    /* ---------- PROJECTS ---------- */

    .project {
      position: relative;
      padding: 32px 0 42px;
      border-top: 1px solid var(--line);
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 30px;
    }

    .project:last-child {
      border-bottom: 1px solid var(--line);
    }

    .project-number {
      color: var(--accent);
      font-family: monospace;
      font-size: 13px;
      padding-top: 5px;
    }

    .project-type {
      color: var(--dim);
      font-size: 10px;
      letter-spacing: .14em;
      font-weight: 700;
    }

    .project h3 {
      margin-top: 7px;
      font-size: 28px;
      letter-spacing: -.035em;
    }

    .project p {
      color: var(--muted);
      max-width: 700px;
      margin-top: 10px;
      font-size: 15px;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 18px;
    }

    .chip {
      padding: 5px 10px;
      border: 1px solid var(--line);
      border-radius: 20px;
      color: var(--dim);
      font-size: 11px;
    }

    .project-motif {
      width: 100px;
      height: 100px;
      margin-top: 10px;
      opacity: 1;
    }

    /* ---------- CONTROL VISUAL ---------- */

    .control-visual {
      margin-top: 70px;
      height: 130px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card);
      overflow: hidden;
      position: relative;
    }

    .control-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    .wave {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .wave path {
      fill: none;
      stroke: var(--accent);
      stroke-width: 1.5;
      stroke-dasharray: 900;
      stroke-dashoffset: 900;
      animation: waveDraw 3.5s ease-in-out infinite;
    }

    @keyframes waveDraw {
      0% { stroke-dashoffset: 900; }
      45%, 75% { stroke-dashoffset: 0; }
      100% { stroke-dashoffset: -900; }
    }

    /* ---------- EDUCATION ---------- */

    .education-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .edu-card {
      padding: 30px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      transition: .25s;
    }

    .edu-card:hover {
      transform: translateY(-3px);
      border-color: rgba(79,140,255,.3);
    }

    .edu-card .year {
      color: var(--accent);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .12em;
    }

    .edu-card h3 {
      margin-top: 10px;
      font-size: 21px;
    }

    .edu-card p {
      margin-top: 5px;
      color: var(--muted);
      font-size: 14px;
    }

    .grade {
      margin-top: 22px;
      color: var(--dim);
      font-size: 12px;
    }

    .grade strong {
      color: var(--text);
      font-size: 18px;
    }

    /* ---------- SKILLS ---------- */

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      max-width: 900px;
    }

    .skill {
      padding: 9px 14px;
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--muted);
      font-size: 13px;
      background: rgba(255,255,255,.015);
      transition: .2s;
    }

    .skill:hover {
      color: var(--text);
      border-color: rgba(79,140,255,.4);
      background: var(--glow);
    }

    /* ---------- TELEGRAM ---------- */

    .telegram {
      padding: 90px 0;
    }

    .telegram-card {
      position: relative;
      overflow: hidden;
      padding: 48px;
      border-radius: 15px;
      border: 1px solid rgba(79,140,255,.25);
      background:
        radial-gradient(circle at 90% 50%, rgba(79,140,255,.12), transparent 35%),
        var(--card);
    }

    .telegram-content {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .channel-photo {
      width: 92px;
      height: 92px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .telegram-card h2 {
      font-size: 34px;
      letter-spacing: -.035em;
    }

    .telegram-card p {
      color: var(--muted);
      margin-top: 10px;
      max-width: 570px;
    }

    .telegram-link {
      display: inline-block;
      margin-top: 24px;
      color: var(--accent2);
      font-weight: 700;
      font-size: 14px;
    }

    .orbit {
      position: absolute;
      width: 270px;
      height: 270px;
      right: 50px;
      top: 50%;
      transform: translateY(-50%);
      opacity: .45;
    }

    .orbit circle {
      fill: none;
      stroke: var(--accent);
      stroke-width: 1;
    }

    .orbit .sat {
      fill: var(--accent);
      transform-origin: 135px 135px;
      animation: orbit 18s linear infinite;
    }

    @keyframes orbit {
      to { transform: rotate(360deg); }
    }

    /* ---------- SIGNATURE ---------- */

    .signature-section {
      padding: 100px 0 60px;
      text-align: center;
    }

    .signature-wrap {
      max-width: 760px;
    }

    .signature-label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .16em;
      color: var(--accent2);
      text-transform: uppercase;
      margin-bottom: 26px;
    }

    .signature-line {
      width: 64px;
      height: 1px;
      background: var(--line);
      margin: 0 auto 38px;
    }

    .signature-image {
      width: min(360px, 70vw);
      height: auto;
      display: block;
      margin: 0 auto;
      opacity: 0;
      transform: translateY(18px) scale(.97);
      transition:
        opacity 1.1s cubic-bezier(.16,1,.3,1),
        transform 1.2s cubic-bezier(.16,1,.3,1);
    }

    .signature-section.visible .signature-image {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .signature-name {
      margin-top: 26px;
      font-size: 14px;
      color: var(--muted);
      letter-spacing: .04em;
    }

    .signature-motto {
      margin-top: 8px;
      font-size: 13px;
      color: var(--dim);
      font-style: italic;
    }

    @media (prefers-reduced-motion: reduce) {
      .signature-image {
        opacity: 1;
        transform: none;
      }
    }

    /* ---------- CONTACT ---------- */

    .contact {
      text-align: center;
      padding: 130px 0 100px;
    }

    .contact h2 {
      font-size: clamp(42px, 6vw, 70px);
      letter-spacing: -.055em;
      line-height: 1;
    }

    .contact p {
      margin: 20px auto 30px;
      color: var(--muted);
      max-width: 550px;
    }

    .contact-email {
      color: var(--accent2);
      font-size: 18px;
      font-weight: 650;
    }

    footer {
      padding: 28px 0 35px;
      color: var(--dim);
      font-size: 11px;
      text-align: center;
    }

    /* ---------- REVEAL ---------- */

    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity .7s cubic-bezier(.16,1,.3,1),
        transform .7s cubic-bezier(.16,1,.3,1);
    }

    .reveal.visible {
      opacity: 1;
      transform: none;
    }

    /* ---------- MOBILE ---------- */

    @media (max-width: 800px) {
      .nav-links {
        display: none;
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .education-grid {
        grid-template-columns: 1fr;
      }

      .project {
        grid-template-columns: 45px 1fr;
        gap: 15px;
      }

      .orbit {
        opacity: .12;
        right: -80px;
      }

      .telegram-card {
        padding: 32px;
      }

      .telegram-content {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }

      .reveal {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>

<body>

<canvas id="stars"></canvas>

<nav>
  <a class="logo" href="/">SKy <span>MaZe</span></a>

  <div class="nav-links">
    <a href="#about">About</a>
    <a href="#experience">Experience</a>
    <a href="#projects">Selected Work</a>
    <a href="#education">Education</a>
    <a href="#contact">Contact</a>
  </div>
</nav>


<!-- HERO -->

<section class="hero">
  <div class="eyebrow">SKy MaZe · Control · Software · Aerospace</div>

  <h1 class="hero-name">Seyed Kazem<br />Moosavi Zargar</h1>
  <p class="hero-role">Control Systems &amp; Software Engineer</p>
  <p class="hero-line">
    Building intelligent systems where mechanics, control,
    software and learning meet.
  </p>

  <div class="hero-motto">A man who never gives up.</div>

  <div class="hero-actions">
    <a href="/CV.pdf" class="button primary">Download CV</a>
    <a href="https://www.linkedin.com/in/kazemmoosavi/" class="button">LinkedIn</a>
    <a href="https://github.com/skmz1380" class="button">GitHub</a>
    <a href="mailto:me@skymaze.ir" class="button">Contact</a>
  </div>
</section>


<!-- ABOUT -->

<section class="section" id="about">
  <div class="container">

    <div class="section-heading reveal">
      <div class="eyebrow">About</div>
      <h2>Engineering the unknown.</h2>
    </div>

    <div class="about-grid">

      <div class="about-text reveal">
        I am a <strong>Control Systems & Software Engineer</strong> with a
        background in Mechanical Engineering and a focus on dynamics and
        intelligent control.

        <br /><br />

        My work sits at the intersection of
        <strong> control theory, software, robotics, machine learning
        and aerospace systems</strong>.

        <br /><br />

        From reinforcement-learning-assisted rehabilitation robots to
        satellite attitude control and aircraft engine control systems,
        I enjoy understanding complex systems and turning them into
        something that can be modeled, controlled and built.
      </div>

      <div class="facts reveal">

        <div class="fact">
          <small>Current role</small>
          <strong>Control Systems & Software Engineer</strong>
        </div>

        <div class="fact">
          <small>Company</small>
          <strong>MAPNA Group · AERO</strong>
        </div>

        <div class="fact">
          <small>Education</small>
          <strong>M.Sc. Mechanical Engineering · Sharif University</strong>
        </div>

        <div class="fact">
          <small>Focus</small>
          <strong>Control · AI · Aerospace · Robotics</strong>
        </div>

      </div>

    </div>
  </div>
</section>


<!-- EXPERIENCE -->

<section class="section" id="experience">
  <div class="container">

    <div class="section-heading reveal">
      <div class="eyebrow">Experience</div>
      <h2>Where I have been.</h2>
    </div>

    <div class="timeline">

      <div class="timeline-item reveal">
        <div class="date">Feb 2026 — Present</div>
        <h3>Control Systems & Software Engineer</h3>
        <div class="company">MAPNA Group · AERO</div>
        <p>
          Developing the engine control systems of various aircrafts and software reverse engineering in an aerospace
          engineering environment.
        </p>
      </div>

      <div class="timeline-item reveal">
        <div class="date">May 2025 — Jul 2025</div>
        <h3>Attitude Determination & Control Systems Engineer</h3>
        <div class="company">SpaceOMID</div>
        <p>
          Developed ADCS modes for the Kosar 1.5 satellite, performed
          actuator testing and upgraded the SIL simulation environment.
        </p>
      </div>

      <div class="timeline-item reveal">
        <div class="date">Oct 2024 — Oct 2025</div>
        <h3>Laboratory Manager</h3>
        <div class="company">Sharif University of Technology · Mechatronics Research Lab</div>
        <p>
          Managed laboratory activities and supported research and
          experimental work in mechatronics and control.
        </p>
      </div>

      <div class="timeline-item reveal">
        <div class="date">2023 — 2025</div>
        <h3>Research & Teaching Assistant</h3>
        <div class="company">Amirkabir University of Technology</div>
        <p>
          Research and teaching activities across dynamics, automatic
          control and hydraulic & pneumatic systems.
        </p>
      </div>

    </div>

    <div class="org-logos reveal">
      <img src="/logos/mapna.png" alt="MAPNA Group" />
      <img src="/logos/spaceomid.svg" alt="SpaceOMID" />
      <img src="/logos/sharif.png" alt="Sharif University of Technology" />
      <img src="/logos/aut.png" alt="Amirkabir University of Technology" />
    </div>

  </div>
</section>


<!-- PROJECTS -->

<section class="section" id="projects">
  <div class="container">

    <div class="section-heading reveal">
      <div class="eyebrow">Selected Work</div>
      <h2>Inside the maze.</h2>
      <p>
        A few systems I have designed, modeled, controlled or reconstructed.
      </p>
    </div>

    {projects.map((project) => (
      <article class="project reveal">

        <div class="project-number">
          {project.number}
        </div>

        <div>
          <div class="project-type">
            {project.type}
          </div>

          <h3>{project.title}</h3>

          <p>
            {project.subtitle}
          </p>

          <div class="chips">
            {project.tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>

          {project.motif && (
            <img src={project.motif} alt="" class="project-motif" />
          )}
        </div>

      </article>
    ))}

    <div class="control-visual reveal">
      <div class="control-grid"></div>

